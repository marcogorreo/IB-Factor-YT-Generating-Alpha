# Copia come `.env.local` e compila i valori. Non committare segreti.

# Next / proxy
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
API_GATEWAY_INTERNAL_URL=http://127.0.0.1:4000

# Microservizi
API_GATEWAY_PORT=4000
INSIGHTS_SERVICE_PORT=4001
INSIGHTS_SERVICE_URL=http://127.0.0.1:4001
YOUTUBE_SERVICE_URL=http://127.0.0.1:4002
YOUTUBE_SERVICE_PORT=4002

DATABASE_URL=postgresql://youtube:youtube@127.0.0.1:5433/youtube_insights
YOUTUBE_CHANNEL_HANDLE=Ingegneriinborsa

# LLM — usato da insights-service (Anthropic)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ID modello dalla console Anthropic (es. claude-sonnet-4-6 o stringa con data)
ANTHROPIC_MODEL=claude-sonnet-4-6
